+}
+.lightbox-close:hover {
+  background: rgba(255,255,255,0.3);
+}
+.lightbox-caption {
+  color: rgba(255,255,255,0.7);
+  font-size: 0.8rem;
+  margin-top: 12px;
   font-family: var(--font-mono);
 }
 
